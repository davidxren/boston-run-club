# Postgres. Local: docker compose up db, then this URL. Prod: any Postgres URL (Neon).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/runclubs

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Magic link email. When RESEND_API_KEY is unset and NODE_ENV is not production,
# EMAIL_TRANSPORT=console prints the sign-in link to stdout instead of sending.
RESEND_API_KEY=
EMAIL_TRANSPORT=console
EMAIL_FROM=

# Comma separated admin emails. No admin flag exists in the database.
ADMIN_EMAILS=

# Product name. Undecided. Every user-facing surface reads this.
NEXT_PUBLIC_APP_NAME=PLACEHOLDER

# Optional. PostHog loads only when set.
NEXT_PUBLIC_POSTHOG_KEY=

# Test hooks. Set by pnpm test:e2e, never in production. Enables the X-Test-Now
# header and writes the last sign-in link to .tmp/last-signin-link.txt.
TEST_HOOKS=
